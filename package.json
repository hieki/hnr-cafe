{
  "name": "hnr-cafe",
  "version": "1.0.0",
  "description": "hnr-cafe.",
  "private": true,
  "scripts": {
    "build": "npm run fmt && run-p build:*",
    "build:js": "webpack",
    "build:html": "ts-node --project ./tsconfig.node.json ./build.ts",
    "build:sounds": "cp -r ./client/sounds ./public/sounds",
    "fmt": "run-p eslint",
    "eslint": "eslint -c .eslintrc.json \"./**/*.{js,ts}\"",
    "eslint-fix": "eslint --fix -c .eslintrc.json \"./**/*.{js,ts}\""
  },
  "author": "hieki",
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/ejs": "^3.1.5",
    "@types/gtag.js": "0.0.20",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "ejs": "^4.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ejs-js": "^0.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1"
  }
}
